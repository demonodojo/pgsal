import "../../md5.sal"
import "support/assert.sal"

fn main() -> Int ! io, alloc
    f = 0
    f = f + ck_str(md5_hex(""), "d41d8cd98f00b204e9800998ecf8427e", 1)
    f = f + ck_str(md5_hex("abc"), "900150983cd24fb0d6963f7d28e17f72", 2)
    f = f + ck_str(md5_hex("The quick brown fox jumps over the lazy dog"), "9e107d9d372bb6826bd81d3542a419d6", 3)
    f = f + ck_str(md5_hex("12345678901234567890123456789012345678901234567890123456789012345678901234567890"), "57edf4a22be3c955ac49da2e2107b67a", 4)
    f
